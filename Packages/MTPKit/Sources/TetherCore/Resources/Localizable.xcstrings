{
  "sourceLanguage" : "en",
  "strings" : {
    "%@, %@" : {
      "shouldTranslate" : false
    },
    "%@, %@ available of %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, %2$@ available of %3$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, доступно %@ из %@"
          }
        }
      }
    },
    "%@, cancelled" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, отменено"
          }
        }
      }
    },
    "%@, done" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, готово"
          }
        }
      }
    },
    "%@, failed: %@" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@, failed: %2$@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ошибка: %@"
          }
        }
      }
    },
    "%@, folder" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, папка"
          }
        }
      }
    },
    "%@, waiting" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@, ожидание"
          }
        }
      }
    },
    "A name can’t be empty." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя не может быть пустым."
          }
        }
      }
    },
    "Ask Every Time" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всегда спрашивать"
          }
        }
      }
    },
    "Document" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Документ"
          }
        }
      }
    },
    "Folder" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папка"
          }
        }
      }
    },
    "Keep Both" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Оставить оба"
          }
        }
      }
    },
    "Names can’t contain “/” or be “.” or “..”." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя не может содержать «/» или быть «.» или «..»."
          }
        }
      }
    },
    "Replace" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заменить"
          }
        }
      }
    },
    "Skip" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пропустить"
          }
        }
      }
    },
    "The name “%@” is already taken. Please choose a different name." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Имя «%@» уже занято. Выберите другое имя."
          }
        }
      }
    },
    "The phone was reconnected, so this folder may have changed. Upload the item again." : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Телефон был переподключён, поэтому содержимое папки могло измениться. Загрузите объект ещё раз."
          }
        }
      }
    },
    "untitled folder" : {
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
